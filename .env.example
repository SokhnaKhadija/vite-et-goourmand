# Copiez ce fichier en .env et remplissez les valeurs
# Les variables marquées (obligatoire) n'ont volontairement aucune valeur par défaut dans le code.

# ── Sécurité ────────────────────────────────────────────────
# (obligatoire) Clé de signature des sessions — longue et aléatoire
SECRET_KEY=votre-cle-secrete-tres-longue-et-aleatoire

# ── MongoDB (base de données unique) ────────────────────────
# (obligatoire) Local : mongodb://localhost:27017/
# Atlas : mongodb+srv://utilisateur:motdepasse@cluster.mongodb.net/
MONGO_URI=mongodb://localhost:27017/
MONGO_DBNAME=vite_et_gourmand

# ── Compte administrateur initial ───────────────────────────
# (obligatoire) Créé automatiquement au premier démarrage
ADMIN_EMAIL=jose@viteetsourmand.fr
ADMIN_PASSWORD=Admin@VG2025!

# ── Serveur de développement (python run.py) ────────────────
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=true
# URL publique de l'application, utilisée dans les liens des e-mails
APP_BASE_URL=http://localhost:5001

# ── E-mails simulés ─────────────────────────────────────────
CONTACT_EMAIL=contact@viteetsourmand.fr
MAIL_LOG_FILE=emails.log

# ── Upload d'images ─────────────────────────────────────────
MAX_UPLOAD_MB=16

# ── Livraison ───────────────────────────────────────────────
# Gratuite dans cette ville, forfait fixe (en €) ailleurs
VILLE_LIVRAISON_GRATUITE=Bordeaux
FRAIS_LIVRAISON_HORS_ZONE=15
